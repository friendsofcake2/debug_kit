{
    "name": "friendsofcake2/debug_kit",
    "description": "CakePHP 2 Debug Kit",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "debug", "kit"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "cakephp/cakephp": "^2.10",
        "composer/installers": "*"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^1.0.0",
        "friendsofcake2/cakephp": "^2.10",
        "phpunit/phpunit": "^9.5"
    },
    "replace": {
        "cakephp/debug_kit": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-name": "DebugKit"
    }
}
